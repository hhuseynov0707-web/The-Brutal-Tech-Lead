# Copy to .env and fill in your values.

# Required: https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
GROQ_MODEL=openai/gpt-oss-120b
# Vision model used to OCR scanned PDFs and CV photos
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OCR_MAX_PAGES=4
INTERVIEW_ROLE=AI Engineer
MAX_TURNS=8
HISTORY_WINDOW=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_SCRAPER=false
LOG_LEVEL=INFO
